    "voice_hint" : {
      "comment" : "The quick reference on how to customize the voice list",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um eine bessere Version einer Stimme zu verwenden, eine neue hinzuzufügen oder eine zuvor hinzugefügte Stimme zu entfernen, wählen Sie Einstellungen → Bedienungshilfen → VoiceOver → Sprachausgabe → Stimme"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To use a better version of a voice, add a new one, or remove a previously added one, go to Settings → Accessibility → VoiceOver → Speech → Voice"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To use a better version of a voice, add a new one, or remove a previously added one, go to Settings → Accessibility → VoiceOver → Speech → Voice"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para usar una mejor versión de una voz, agregar una nueva o eliminar una agregada anteriormente, vaya a Configuración → Accesibilidad → VoiceOver → Leer → Voz"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pet utilizzare una versione migliore di una voce, aggiungerne una nuova o rimuoverne una aggiunta in precedenza, vai su Impostazioni → Accessibilità → Voce fuoricampo → Discorso → Voce"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고품질 버전의 음성을 사용하거나 새 음성을 추가하거나 이전에 추가 한 음성을 제거하려면 설정 → 접근성 → VoiceOver → 음성 → 음성으로 이동합니다"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы использовать более качественный вариант какого-либо голоса, добавить новый или удалить ранее добавленный, выберите Настройки → Универсальный доступ → VoiceOver → Речь → Голос"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб використовувати більш якісний варіант будь-якого голосу, додати новий або видалити раніше доданий, виберіть Налаштування → Універсальний доступ → VoiceOver → Мова → Голос"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了使用更好的声音版本，请添加新的声音，或取消以前添加的声音，请转至设置→通用访问→VoiceOver→语音→声音"
          }
        }
      }
    },
