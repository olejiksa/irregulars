    "onboarding.three_forms.description" : {
      "extractionState" : "migrated",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nIn order to avoid mistakes in English tenses, it is necessary to know three forms of the verb:\ninfinitive,\npast tense,\npast participle\n"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nIn order to avoid mistakes in English tenses, it is necessary to know three forms of the verb:\ninfinitive,\npast tense,\npast participle\n"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nЧтобы не допускать ошибок в английских временах, необходимо знать 3 формы глагола:\nначальную, или инфинитив,\nформу прошедшего времени\nи третью форму, или причастие прошедшего времени\n"
          }
        }
      }
    },
