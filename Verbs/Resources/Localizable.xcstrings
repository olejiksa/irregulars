    "empty_favorites" : {
      "comment" : "Explains what needs to be done for verbs to appear in Favorites",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um das unregelmäßige Verb in Favoriten hinzuzufügen, wählen Sie es aus der Liste von allen Verben und klicken Sie das Sternchen im rechten Teil des Displays an"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To add an irregular verb to your Favorites, open it from the all verbs list and tap the star button in the top right corner of the screen"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To add an irregular verb to your Favourites, open it from the all verbs list and tap the star button in the top right corner of the screen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para agregar un verbo irregular a sus Favoritos, ábralo desde la lista de todos los verbos y toque el botón de estrella en la esquina superior derecha de la pantalla"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per aggiungere un verbo irregolare ai tuoi preferiti, aprilo dall'elenco di tutti i verbi e fai clic sul pulsante a stella nell'angolo in alto a destra dello schermo"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“즐겨찾기” 없습니다"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы добавить неправильный глагол в «Избранное», откройте его из списка всех глаголов и нажмите на кнопку-звездочку в правом верхнем углу экрана"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб додати неправильне дієслово в «Уподобання», відкрийте його із списку усіх дієслів та натисніть на кнопку-зірочку у правому верхньому куті екрана"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了把不规则动词添加到«收藏夹»，请从所有动词表中打开需要的词，然后在屏幕右边点击星形按键"
          }
        }
      }
    },
