    "learned_verbs_footer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Wort gilt als gelernt, wenn es mindestens 3 mal richtig gewählt wurde. Wenn die Antwort richtig war, nimmt das Niveau des Verberlernens um eins zu, andernfalls nimmt es ab"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A word is considered learned if it was answered correctly at least 3 times. If the answer turned out to be right, the verb knowledge metric increases by one, otherwise it decreases"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A word is considered learned if it was answered correctly at least 3 times. If the answer turned out to be right, the verb knowledge metric increases by one, otherwise it decreases"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una palabra se considera aprendida si fue respondida correctamente al menos 3 veces. Si la respuesta resultó ser correcta, la métrica de conocimiento del verbo aumenta en uno, de lo contrario disminuye"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una parola è considerata appresa se ha ricevuto una risposta corretta almeno 3 volte. Se la risposta si è rivelata corretta, lo studio del verbo aumenta di uno, altrimenti diminuisce"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단어가 3 번 이상 정답이면 학습 된 것으로 간주됩니다. 답이 옳은 것으로 판명되면 동사 연구가 1 씩 증가하고 그렇지 않으면 감소합니다"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слово считается изученным, если оно было отвечено верно не менее 3 раз. Если ответ оказался правильным, изученность глагола увеличивается на единицу, иначе — уменьшается"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слово вважається вивченим, якщо на нього було дано відповідь вірно не менше 3 разів. Якщо відповідь виявилася правильною, вивченість дієслова збільшується на одиницю, інакше — зменшується"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果一个单词至少被正确回答了3次，该单词是学习过的。如果答案是正确的，则动词的学习增加一，否则减少。"
          }
        }
      }
    },
