    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - Microphone Usage Description",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recording is used only for pronunciation training. The data associated with it is cleared from the cache after the application terminates."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recording is used only for pronunciation training. The data associated with it is cleared from the cache after the application terminates."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recording is used only for pronunciation training. The data associated with it is cleared from the cache after the application terminates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recording is used only for pronunciation training. The data associated with it is cleared from the cache after the application terminates."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recording is used only for pronunciation training. The data associated with it is cleared from the cache after the application terminates."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recording is used only for pronunciation training. The data associated with it is cleared from the cache after the application terminates."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись речи используется только для тренировки произношения. Связанные с ней данные очищаются из кэша после завершения работы приложения"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис мови використовується тільки для тренування вимови. Зв'язані з нею дані видаляються з кешу після завершення роботи програми."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recording is used only for pronunciation training. The data associated with it is cleared from the cache after the application terminates."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spracherkennung läuft vollständig auf diesem Gerät und dient nur dazu, die Aussprache des angezeigten Verbs zu prüfen. Es wird nichts aufgezeichnet, gespeichert oder übertragen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition runs entirely on this device and is used only to check the pronunciation of the verb on screen. Nothing is recorded, stored or sent anywhere"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition runs entirely on this device and is used only to check the pronunciation of the verb on screen. Nothing is recorded, stored or sent anywhere"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz funciona por completo en este dispositivo y solo sirve para comprobar la pronunciación del verbo en pantalla. No se graba, almacena ni envía nada"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riconoscimento vocale funziona interamente su questo dispositivo e serve solo a verificare la pronuncia del verbo mostrato. Nulla viene registrato, conservato o inviato"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 인식은 전적으로 이 기기에서 실행되며 화면에 표시된 동사의 발음을 확인하는 데에만 사용됩니다. 어떤 것도 녹음, 저장되거나 전송되지 않습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание речи работает целиком на этом устройстве и используется только для проверки произношения глагола на экране. Ничего не записывается, не хранится и никуда не передаётся"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розпізнавання мовлення працює повністю на цьому пристрої та використовується лише для перевірки вимови дієслова на екрані. Нічого не записується, не зберігається й нікуди не передається"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音识别完全在本设备上运行，仅用于检查屏幕上动词的发音。不会录制、存储或发送任何内容"
          }
        }
      }
    },
